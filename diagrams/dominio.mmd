classDiagram
    class Usuario {
        +id: int
    }

    class Treino {
        +id: int
        +data: date
    }

    class Exercicio {
        +id: int
        +nome: string
    }

    class Serie {
        +id: int
        +repeticoes: int
        +carga: decimal
    }

    class Meta {
        +id: int
        +tipo: string
        +valor_diario: decimal
    }

    Usuario "1" --> "0..*" Treino : registra
    Treino "1" *-- "1..*" Exercicio : contem
    Exercicio "1" *-- "1..*" Serie : contem
    Usuario "1" --> "0..*" Meta : define